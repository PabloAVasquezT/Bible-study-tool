{
  "name": "bible-study-tool",
  "version": "0.1.0",
  "description": "A free, offline-capable Bible study web app with Strong's numbers, lexicons and cross-references",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "data:bibles": "node scripts/data/build-bibles.ts",
    "data:lexicons": "node scripts/data/build-lexicons.ts",
    "data:crossrefs": "node scripts/data/build-crossrefs.ts",
    "data:search": "node scripts/data/build-search.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
