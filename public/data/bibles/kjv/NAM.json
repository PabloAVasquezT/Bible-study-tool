{"text":["Thy ",{"t":"crowned","s":"H4502"}," ",{"t":"are","f":1}," as the ",{"t":"locusts","s":"H697"},", and thy ",{"t":"captains","s":"H2951"}," as the great ",{"t":"grasshoppers","s":"H1462"},", which ",{"t":"camp","s":"H2583"}," in the ",{"t":"hedges","s":"H1448"}," in the ",{"t":"cold","s":"H7135"}," ",{"t":"day","s":"H3117"},", ",{"t":"but","f":1}," when the ",{"t":"sun","s":"H8121"}," ",{"t":"ariseth","s":"H2224"}," they flee ",{"t":"away","s":"H5074"},", and their ",{"t":"place","s":"H4725"}," is not ",{"t":"known","s":"H3045"}," ",{"t":"where","s":"H335"}," they ",{"t":"are","f":1},"."]},
{"text":["Thy ",{"t":"shepherds","s":"H7462"}," ",{"t":"slumber","s":"H5123"},", O ",{"t":"king","s":"H4428"}," of ",{"t":"Assyria","s":"H804"},": thy ",{"t":"nobles","s":"H117"}," shall ",{"t":"dwell","s":"H7931"}," ",{"t":"in the dust:","f":1}," thy ",{"t":"people","s":"H5971"}," is ",{"t":"scattered","s":"H6335"}," upon the ",{"t":"mountains","s":"H2022"},", and no man ",{"t":"gathereth","s":"H6908"}," ",{"t":"them","f":1},".",{"note":["nobles: or, valiant ones"]}]},
{"text":[{"t":"There is","f":1}," no ",{"t":"healing","s":"H3545"}," of thy ",{"t":"bruise","s":"H7667"},"; thy ",{"t":"wound","s":"H4347"}," is ",{"t":"grievous","s":"H2470"},": all that ",{"t":"hear","s":"H8085"}," the ",{"t":"bruit","s":"H8088"}," of thee shall ",{"t":"clap","s":"H8628"}," the ",{"t":"hands","s":"H3709"}," over thee: for upon whom hath not thy ",{"t":"wickedness","s":"H7451"}," ",{"t":"passed","s":"H5674"}," ",{"t":"continually","s":"H8548"},"?",{"note":["healing: Heb. wrinkling"]}]}
